BOT_TOKEN=your_bot_token_from_botfather
ANTHROPIC_API_KEY=your_anthropic_api_key
MINI_APP_URL=https://your-hosted-webapp-url.example.com/webapp/index.html
STOCK_APP_URL=https://your-hosted-webapp-url.example.com/webapp/stock.html
COOK_CHAT_ID=

# Optional — defaults shown
REMINDER_HOUR=20
COMPILE_HOUR=21
COMPILE_MINUTE=30
TIMEZONE=Africa/Johannesburg

# Weekly shopping list — 0=Monday ... 6=Sunday
WEEKLY_SHOPPING_DAY=6
WEEKLY_SHOPPING_HOUR=21
WEEKLY_SHOPPING_MINUTE=35

# Alert the cook when an ingredient has fewer than this many typical
# servings left in stock
LOW_STOCK_SERVINGS=2
