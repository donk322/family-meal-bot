BOT_TOKEN=your_bot_token_from_botfather
ANTHROPIC_API_KEY=your_anthropic_api_key
MINI_APP_URL=https://your-hosted-webapp-url.example.com/webapp/index.html
STOCK_APP_URL=https://your-hosted-webapp-url.example.com/webapp/stock.html
COOK_CHAT_ID=

# Optional — defaults shown
REMINDER_HOUR=17
REMINDER_MINUTE=45
COMPILE_HOUR=20
COMPILE_MINUTE=0
TIMEZONE=Africa/Johannesburg

# Голос этого Telegram username весит как FAMILY_HEAD_VOTE_WEIGHT голосов
# при определении победителя (но НЕ влияет на число порций) — оставь пустым,
# чтобы отключить
FAMILY_HEAD_USERNAME=psgsports
FAMILY_HEAD_VOTE_WEIGHT=2

# Weekly shopping list — 0=Monday ... 6=Sunday
WEEKLY_SHOPPING_DAY=6
WEEKLY_SHOPPING_HOUR=21
WEEKLY_SHOPPING_MINUTE=35

# Alert the cook when an ingredient has fewer than this many typical
# servings left in stock (8 ≈ one full family-size batch)
LOW_STOCK_SERVINGS=8

# /whatstobuy suggests buying enough for this many servings at once (a
# realistic family-batch shopping quantity, not just one portion)
WHATSTOBUY_SERVINGS=8

# Сколько лишних порций готовить сверх числа проголосовавших (запас на добавку)
PORTION_BUFFER_EXTRA=1
